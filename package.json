{
  "name": "@ztechjs/zt-ui",
  "version": "0.9.0",
  "description": "Zt UI — Vue 3 中后台企业级组件库，TypeScript 优先，玻璃拟态视觉，约 80 个开箱即用组件",
  "type": "module",
  "license": "MIT",
  "author": "ztech",
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "ui",
    "components",
    "component-library",
    "element",
    "design-system",
    "admin",
    "dashboard",
    "vue-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevqin/zt-ui.git"
  },
  "homepage": "https://stevqin.github.io/zt-ui/",
  "bugs": {
    "url": "https://github.com/stevqin/zt-ui/issues"
  },
  "main": "./dist/zt-ui.umd.cjs",
  "module": "./dist/zt-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/zt-ui.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/zt-ui.js",
      "require": "./dist/zt-ui.umd.cjs"
    },
    "./style.css": "./dist/zt-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && vite build --mode umd",
    "prepublishOnly": "npm test && npm run build",
    "preview": "vite preview",
    "audit:components": "node scripts/audit-component-contracts.mjs"
  },
  "peerDependencies": {
    "@visactor/vtable": "^1.26.7",
    "@visactor/vtable-editors": "^1.26.7",
    "@visactor/vue-vtable": "^1.26.7",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@visactor/vtable": "^1.26.8",
    "@visactor/vtable-editors": "^1.26.8",
    "@visactor/vue-vtable": "^1.26.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "20.8.9",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  },
  "dependencies": {
    "@ztechjs/zt-alert": "^0.1.2"
  }
}
