{
  "name": "zt-ui-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:api": "node scripts/extract-api.mjs && node scripts/extract-alert-api.mjs",
    "docs:check": "node scripts/check-content.mjs",
    "predev": "npm run docs:api",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "pretest": "npm run docs:api",
    "test": "vitest run",
    "prebuild": "npm run docs:api && npm run docs:check",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ztechjs/zt-alert": "^0.1.4",
    "@ztechjs/zt-ui": "file:..",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "20.8.9",
    "prettier": "^3.9.7",
    "sass": "^1.89.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
